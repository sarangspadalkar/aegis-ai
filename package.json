{
  "name": "aegis-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Scalable Event-Driven Media Processing Pipeline",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run build --workspace=packages/shared --workspace=packages/database && tsc --noEmit -p packages/shared && tsc --noEmit -p packages/database && tsc --noEmit -p packages/ingestion && tsc --noEmit -p packages/processor && tsc --noEmit -p packages/infrastructure",
    "build": "npm run build --workspace=packages/shared --workspace=packages/database --workspace=packages/ingestion --workspace=packages/processor --workspace=packages/infrastructure",
    "pretest": "prisma generate --schema packages/database/prisma/schema.prisma",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "npm run clean --workspaces --if-present; rimraf node_modules packages/*/node_modules packages/*/dist",
    "format": "prettier --write \"**/*.{ts,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md,yml,yaml}\"",
    "cdk": "npm run cdk --workspace=packages/infrastructure",
    "deploy": "npm run deploy --workspace=packages/infrastructure"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "testcontainers": "^12.0.2",
    "typescript": "^5.3.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=22.x"
  },
  "author": "",
  "license": "MIT"
}
